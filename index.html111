<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OnStage — Pay-per-view, beautifully simple</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <style>
    :root { --bg:#0b0c0e; --panel:#151619; --panel2:#1b1d21; --line:#282a30; --ink:#f6f3ec; --muted:#a7a8ae; --soft:#73757c; --lime:#d5ff54; --orange:#ff7147; --lavender:#b7a7ff; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--bg); color:var(--ink); font-family:"DM Sans", sans-serif; overflow-x:hidden; }
    button, input { font:inherit; }
    button { cursor:pointer; }
    .shell { max-width:1400px; margin:auto; padding:0 38px; }
    .eyebrow { font:500 11px "DM Mono",monospace; letter-spacing:.12em; text-transform:uppercase; color:var(--lime); }
    nav { height:80px; display:flex; align-items:center; justify-content:space-between; gap:30px; border-bottom:1px solid var(--line); }
    .brand { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink); font-size:20px; font-weight:700; letter-spacing:-.06em; }
    .mark { display:grid; place-items:center; width:26px; height:26px; background:var(--lime); color:#12130f; border-radius:8px 8px 8px 1px; font:700 14px Georgia,serif; letter-spacing:-2px; }
    .nav-links { display:flex; gap:30px; margin-left:30px; flex:1; }
    .nav-links a { color:var(--muted); font-size:14px; text-decoration:none; transition:color .2s; }
    .nav-links a:hover,.nav-links .active { color:var(--ink); }
    .nav-actions { display:flex; align-items:center; gap:18px; }
    .search { color:var(--muted); width:20px; height:20px; }
    .avatar { width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg,#df9d80,#573d6b); border:2px solid #33343a; }
    .nav-cta, .cta { border:0; border-radius:8px; background:var(--lime); color:#12130f; padding:11px 17px; font-weight:700; font-size:13px; transition:transform .2s, box-shadow .2s; }
    .nav-cta:hover,.cta:hover { transform:translateY(-2px); box-shadow:0 10px 25px rgba(213,255,84,.16); }
    .mobile-menu { display:none; color:var(--ink); background:none; border:0; font-size:24px; }
    .hero { display:grid; grid-template-columns:1.04fr .96fr; gap:45px; padding:82px 0 60px; align-items:end; }
    .hero h1 { font-family:"Playfair Display",serif; font-size:clamp(3.3rem,6vw,6rem); line-height:.94; letter-spacing:-.055em; font-weight:600; max-width:720px; margin:16px 0 22px; }
    .hero h1 em { color:var(--lime); font-weight:600; }
    .hero-copy { color:var(--muted); max-width:460px; font-size:17px; line-height:1.55; margin:0 0 30px; }
    .hero-buttons { display:flex; gap:12px; align-items:center; }
    .secondary { border:1px solid #3b3d43; background:transparent; color:var(--ink); padding:10px 17px; border-radius:8px; font-weight:600; font-size:13px; }
    .live-card { position:relative; overflow:hidden; min-height:420px; border-radius:17px; background:#282125; isolation:isolate; }
    .live-card::before { content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 28%,rgba(8,9,10,.83) 100%), url('https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?auto=format&fit=crop&w=1200&q=85') center/cover; z-index:-1; transition:transform .5s; }
    .live-card:hover::before { transform:scale(1.04); }
    .live-tag { position:absolute; top:18px; left:18px; padding:7px 10px; color:#fff; border-radius:5px; background:var(--orange); font:500 10px "DM Mono",monospace; letter-spacing:.1em; }
    .live-tag span { display:inline-block; width:6px; height:6px; border-radius:99px; background:#fff; margin-right:5px; vertical-align:1px; animation:pulse 1.5s infinite; }
    @keyframes pulse{50%{opacity:.3;transform:scale(.7)}}
    .live-info { position:absolute; left:26px; right:24px; bottom:24px; }
    .live-info .meta { color:#d1d1d4; font:11px "DM Mono",monospace; text-transform:uppercase; letter-spacing:.08em; }
    .live-info h2 { font-family:"Playfair Display",serif; font-size:31px; line-height:1.03; letter-spacing:-.04em; margin:9px 0 15px; max-width:420px; }
    .live-bottom { display:flex; justify-content:space-between; align-items:center; }
    .people { display:flex; align-items:center; color:#dadadd; font-size:12px; }
    .people i { display:block; height:24px; width:24px; border-radius:50%; border:2px solid #18191c; margin-left:-8px; background-size:cover; }
    .people i:first-child{margin-left:0;background-image:url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80')}.people i:nth-child(2){background-image:url('https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&q=80')}.people i:nth-child(3){background-image:url('https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80')}
    .people strong { margin-left:8px; font-weight:500; }
    .watch { border:0; background:#fff; color:#101115; font-weight:700; border-radius:7px; padding:10px 13px; font-size:12px; }
    .ticker { border-top:1px solid var(--line); border-bottom:1px solid var(--line); height:64px; overflow:hidden; display:flex; align-items:center; white-space:nowrap; color:#c3c2bd; font:500 11px "DM Mono",monospace; text-transform:uppercase; letter-spacing:.08em; }
    .ticker-track { display:flex; animation:tick 24s linear infinite; }
    .ticker-item { margin-right:46px; }.ticker-item b{color:var(--lime);font-weight:500;margin-right:10px}.ticker-item i{color:#73757c;font-style:normal;margin-left:10px}@keyframes tick{to{transform:translateX(-50%)}}
    .section { padding:86px 0; }
    .section-head { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:29px; gap:20px; }
    .section h2 { font-family:"Playfair Display",serif; letter-spacing:-.04em; font-size:39px; margin:6px 0 0; line-height:1; }
    .link { color:var(--ink); font-size:13px; font-weight:600; text-decoration:none; border-bottom:1px solid #5b5c60; padding-bottom:3px; white-space:nowrap; }
    .events { display:grid; grid-template-columns:repeat(3,1fr); gap:17px; }
    .event { position:relative; min-height:365px; border-radius:13px; overflow:hidden; background:var(--panel); padding:17px; display:flex; flex-direction:column; justify-content:flex-end; isolation:isolate; }
    .event::before { content:""; position:absolute; inset:0; z-index:-2; background-position:center; background-size:cover; transition:transform .45s ease; }.event:hover::before{transform:scale(1.055)}
    .event::after { content:""; position:absolute; inset:0; z-index:-1; background:linear-gradient(180deg,rgba(0,0,0,.04) 25%,rgba(5,5,6,.92) 100%); }
    .event:nth-child(1)::before{background-image:url('https://images.unsplash.com/photo-1521337581100-8ca9a73a5f79?auto=format&fit=crop&w=900&q=82')}.event:nth-child(2)::before{background-image:url('https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=900&q=82')}.event:nth-child(3)::before{background-image:url('https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=900&q=82')}
    .event-tag { align-self:flex-start; background:rgba(7,8,10,.78); color:#fff; border:1px solid rgba(255,255,255,.2); padding:6px 8px; border-radius:4px; font:10px "DM Mono",monospace; letter-spacing:.07em; text-transform:uppercase; }
    .event-date { color:#d8d8da; font:11px "DM Mono",monospace; letter-spacing:.07em; text-transform:uppercase; }.event h3 { font-family:"Playfair Display",serif; font-size:26px; letter-spacing:-.035em; line-height:1.03; margin:8px 0 9px; }.event-footer { display:flex; align-items:center; justify-content:space-between; color:#d9d9db; font-size:12px; }.price { color:var(--lime); font-weight:700; }
    .event .arrow { display:grid; place-items:center; border:1px solid rgba(255,255,255,.32); color:white; border-radius:50%; width:31px;height:31px;font-size:18px;transition:background .2s,color .2s; }.event:hover .arrow{background:var(--lime);color:#10120e;border-color:var(--lime)}
    .feature { padding:50px; display:grid; grid-template-columns:1.1fr .9fr; gap:40px; background:var(--panel); border-radius:17px; overflow:hidden; position:relative; }.feature:after{content:"";position:absolute;width:500px;height:500px;border-radius:50%;background:rgba(183,167,255,.1);right:-250px;top:-280px;pointer-events:none}.feature h2 { font-size:48px; max-width:550px; }.feature-copy{color:var(--muted);font-size:16px;line-height:1.55;max-width:490px;margin:20px 0 26px}.feature-points{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:36px}.point{border-top:1px solid #3a3b40;padding-top:14px}.point span{display:block;font:11px "DM Mono",monospace;color:var(--lime);margin-bottom:6px}.point b{font-size:14px}.console { align-self:center; background:#101115; border:1px solid #303237; border-radius:11px; padding:18px; box-shadow:20px 25px 0 rgba(6,6,7,.24); transform:rotate(2deg); position:relative;z-index:1; }.console-top{display:flex;align-items:center;gap:7px;margin-bottom:18px}.dot{width:7px;height:7px;border-radius:50%;background:#ff7147}.dot:nth-child(2){background:#eecb58}.dot:nth-child(3){background:#8bd383}.console-title{font:10px "DM Mono",monospace;color:#81828a;margin-left:4px}.stream-preview{height:160px;border-radius:7px;background:linear-gradient(135deg,rgba(214,255,84,.18),rgba(104,82,255,.22)),url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=700&q=85') center/cover;position:relative}.stream-preview:after{content:'●  LIVE';position:absolute;top:12px;left:12px;color:#fff;font:10px "DM Mono",monospace;background:#ff7147;padding:5px 7px;border-radius:3px}.console-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}.console-stat{background:#1c1d22;border-radius:5px;padding:10px}.console-stat b{display:block;font-size:17px}.console-stat span{color:#8f9096;font-size:10px}
    .replays { display:grid; grid-template-columns:1.1fr .9fr; gap:18px; }.replay-main{height:318px; border-radius:13px; padding:23px; display:flex; flex-direction:column; justify-content:flex-end; position:relative;overflow:hidden;isolation:isolate;background:#25262b}.replay-main:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,9,10,.9) 0%,rgba(8,9,10,.1) 100%),url('https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1200&q=85') center/cover;z-index:-1}.replay-main h3{font-family:"Playfair Display",serif;font-size:34px;line-height:1;letter-spacing:-.04em;max-width:410px;margin:9px 0}.play-circle{position:absolute;right:24px;bottom:24px;width:44px;height:44px;border-radius:50%;border:0;background:var(--lime);font-size:17px}.replay-list{display:flex;flex-direction:column;gap:12px}.replay-row{flex:1;display:flex;align-items:center;gap:14px;background:var(--panel);padding:11px;border-radius:11px;transition:background .2s}.replay-row:hover{background:#22242a}.replay-thumb{height:74px;width:108px;border-radius:7px;background-size:cover;background-position:center;flex-shrink:0}.replay-row:nth-child(1) .replay-thumb{background-image:url('https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=400&q=80')}.replay-row:nth-child(2) .replay-thumb{background-image:url('https://images.unsplash.com/photo-1618609378035-06ecb1df5c94?auto=format&fit=crop&w=400&q=80')}.replay-row:nth-child(3) .replay-thumb{background-image:url('https://images.unsplash.com/photo-1503235930437-8c6293ba41f5?auto=format&fit=crop&w=400&q=80')}.replay-text{flex:1;min-width:0}.replay-text b{display:block;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.replay-text span{font:10px "DM Mono",monospace;color:var(--soft);margin-top:6px;display:block}.row-price{color:var(--lime);font-weight:700;font-size:13px}
    .creator { margin-top:86px; border-top:1px solid var(--line); padding:78px 0 90px; text-align:center; }.creator h2{font-family:"Playfair Display",serif;font-size:49px;letter-spacing:-.045em;margin:9px auto 16px;max-width:610px;line-height:1}.creator p{color:var(--muted);max-width:480px;margin:0 auto 25px;line-height:1.5}.creator .cta{padding:13px 20px}.trust{display:flex;justify-content:center;gap:34px;color:#82838a;font-size:12px;margin-top:28px}.trust span:before{content:'✓';color:var(--lime);margin-right:6px}
    footer { border-top:1px solid var(--line); padding:28px 0 35px; display:flex; justify-content:space-between; align-items:center; color:#777980; font-size:12px; }.footer-links{display:flex;gap:19px}.footer-links a{color:inherit;text-decoration:none}
    .modal-backdrop{display:none;position:fixed;inset:0;background:rgba(2,3,4,.75);backdrop-filter:blur(6px);z-index:5;align-items:center;justify-content:center;padding:20px}.modal-backdrop.open{display:flex}.modal{width:min(470px,100%);background:#191b1f;border:1px solid #33353b;border-radius:15px;padding:27px;box-shadow:0 30px 80px rgba(0,0,0,.6);position:relative;animation:pop .25s ease}@keyframes pop{from{opacity:0;transform:translateY(12px) scale(.98)}}.modal-close{position:absolute;right:16px;top:16px;border:0;background:#292b30;color:white;width:28px;height:28px;border-radius:50%;font-size:17px}.modal h2{font-family:"Playfair Display",serif;font-size:30px;letter-spacing:-.04em;margin:11px 0 8px}.modal p{color:var(--muted);font-size:14px;line-height:1.5}.checkout-line{display:flex;justify-content:space-between;border-top:1px solid #34363b;margin-top:22px;padding:16px 0;font-size:14px}.checkout-line b{color:var(--lime)}.pay{width:100%;padding:13px;border:0;border-radius:8px;background:var(--lime);font-weight:700}.success{display:none;text-align:center;padding:13px 0 5px}.success .check{display:grid;place-items:center;margin:0 auto 14px;width:50px;height:50px;border-radius:50%;background:var(--lime);color:#111;font-size:25px}.success h2{margin:0}.success p{margin-bottom:0}
    @media(max-width:800px){.shell{padding:0 20px}.nav-links,.nav-actions .search,.nav-actions .avatar{display:none}.mobile-menu{display:block}.nav-actions{gap:10px}.nav-cta{padding:9px 11px}.hero{grid-template-columns:1fr;padding:50px 0 42px;gap:36px}.hero h1{font-size:clamp(3.1rem,15vw,4.8rem)}.live-card{min-height:380px}.events{grid-template-columns:1fr}.event{min-height:310px}.feature,.replays{grid-template-columns:1fr}.feature{padding:29px 23px}.feature h2,.creator h2{font-size:40px}.console{transform:none}.replay-main{height:280px}.replay-list{gap:9px}.replay-row{min-height:87px}.section{padding:62px 0}.creator{margin-top:62px;padding:65px 0}.trust{gap:13px;flex-wrap:wrap}.ticker{margin:0 -20px}.footer-links{display:none}footer{padding:24px 0}.section-head h2{font-size:34px}}
  </style>
</head>
<body>
  <div class="shell">
    <nav>
      <a class="brand" href="#top"><span class="mark">o</span>onstage</a>
      <div class="nav-links"><a class="active" href="#discover">Discover</a><a href="#live">Live now</a><a href="#replays">Replays</a><a href="#creators">For creators</a></div>
      <div class="nav-actions"><svg class="search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><div class="avatar"></div><button class="nav-cta" data-modal="Create your event">Host an event</button><button class="mobile-menu" aria-label="Open menu">☰</button></div>
    </nav>
    <main id="top">
      <section class="hero" id="discover">
        <div><div class="eyebrow">Your audience is waiting</div><h1>Moments worth<br><em>showing up</em> for.</h1><p class="hero-copy">Stream unforgettable events, sell tickets in seconds, and keep every moment alive with on-demand replays.</p><div class="hero-buttons"><button class="cta" data-modal="Start watching">Explore live events</button><button class="secondary" data-scroll="#creators">Host with OnStage ↗</button></div></div>
        <article class="live-card" id="live"><div class="live-tag"><span></span> Live now</div><div class="live-info"><div class="meta">Music · The Nova Theatre</div><h2>Midnight Sessions: live from London</h2><div class="live-bottom"><div class="people"><i></i><i></i><i></i><strong>2.8k watching</strong></div><button class="watch" data-modal="Midnight Sessions: live from London">Watch for £12</button></div></div></article>
      </section>
    </main>
  </div>
  <div class="ticker"><div class="ticker-track"><span class="ticker-item"><b>● live</b> Midnight Sessions <i>£12</i></span><span class="ticker-item"><b>● live</b> Mindful Mornings <i>£7</i></span><span class="ticker-item"><b>● upcoming</b> Field Notes: Kyoto <i>£9</i></span><span class="ticker-item"><b>● replay</b> The Makers' Table <i>£8</i></span><span class="ticker-item"><b>● live</b> Midnight Sessions <i>£12</i></span><span class="ticker-item"><b>● live</b> Mindful Mornings <i>£7</i></span><span class="ticker-item"><b>● upcoming</b> Field Notes: Kyoto <i>£9</i></span><span class="ticker-item"><b>● replay</b> The Makers' Table <i>£8</i></span></div></div>
  <div class="shell">
    <section class="section"><div class="section-head"><div><div class="eyebrow">Coming up</div><h2>Put it in your calendar</h2></div><a class="link" href="#replays">View all events →</a></div><div class="events">
      <article class="event"><span class="event-tag">In 2 days</span><div><div class="event-date">Thu, 12 Sep · 19:30 BST</div><h3>Textures: a design conversation</h3><div class="event-footer"><span><b class="price">£9</b> · Live ticket</span><button class="arrow" aria-label="Buy ticket" data-modal="Textures: a design conversation">↗</button></div></div></article>
      <article class="event"><span class="event-tag">Sat, 14 Sep</span><div><div class="event-date">The Commons · 20:00 BST</div><h3>Afterglow<br>with Aisha Rae</h3><div class="event-footer"><span><b class="price">£14</b> · Live ticket</span><button class="arrow" aria-label="Buy ticket" data-modal="Afterglow with Aisha Rae">↗</button></div></div></article>
      <article class="event"><span class="event-tag">Sun, 15 Sep</span><div><div class="event-date">Cerulean Studio · 11:00 BST</div><h3>The Sunday<br>Stretch Club</h3><div class="event-footer"><span><b class="price">£6</b> · Live + replay</span><button class="arrow" aria-label="Buy ticket" data-modal="The Sunday Stretch Club">↗</button></div></div></article>
    </div></section>
    <section class="feature" id="creators"><div><div class="eyebrow">Built for hosts</div><h2>One place for the whole show.</h2><p class="feature-copy">From a simple link to a sold-out virtual room — run your event without stitching together five different tools.</p><button class="cta" data-modal="Create your event">Create your first event</button><div class="feature-points"><div class="point"><span>01</span><b>Sell live & replay access</b></div><div class="point"><span>02</span><b>Own your audience data</b></div><div class="point"><span>03</span><b>Stream in studio quality</b></div><div class="point"><span>04</span><b>Get paid automatically</b></div></div></div><div class="console"><div class="console-top"><i class="dot"></i><i class="dot"></i><i class="dot"></i><span class="console-title">ONSTAGE STUDIO</span></div><div class="stream-preview"></div><div class="console-stats"><div class="console-stat"><b>2,842</b><span>viewers now</span></div><div class="console-stat"><b>£18.2k</b><span>ticket sales</span></div><div class="console-stat"><b>98%</b><span>watched live</span></div></div></div></section>
    <section class="section" id="replays"><div class="section-head"><div><div class="eyebrow">Watch it again</div><h2>Newly added replays</h2></div><a class="link" href="#replays">Browse the library →</a></div><div class="replays"><article class="replay-main"><div class="eyebrow">Featured replay</div><h3>Echoes of a creative life</h3><div class="event-date">88 min · Recorded 3 days ago</div><button class="play-circle" aria-label="Play replay" data-modal="Echoes of a creative life">▶</button></article><div class="replay-list"><article class="replay-row"><div class="replay-thumb"></div><div class="replay-text"><b>Live at the Glasshouse</b><span>Concert · 1h 22m</span></div><span class="row-price">£10</span><button class="arrow" data-modal="Live at the Glasshouse" aria-label="Buy replay">↗</button></article><article class="replay-row"><div class="replay-thumb"></div><div class="replay-text"><b>From idea to icon</b><span>Talk · 47m</span></div><span class="row-price">£8</span><button class="arrow" data-modal="From idea to icon" aria-label="Buy replay">↗</button></article><article class="replay-row"><div class="replay-thumb"></div><div class="replay-text"><b>The perfect aperitivo</b><span>Workshop · 54m</span></div><span class="row-price">£7</span><button class="arrow" data-modal="The perfect aperitivo" aria-label="Buy replay">↗</button></article></div></div></section>
    <section class="creator"><div class="eyebrow">More than a stream</div><h2>Your next event has an audience.</h2><p>Build a home for the things only you can put on stage. No subscriptions. No complicated setup.</p><button class="cta" data-modal="Create your event">Start hosting for free</button><div class="trust"><span>Free to set up</span><span>Creators keep 80% before taxes</span><span>Cancel anytime</span></div></section>
    <footer><a class="brand" href="#top"><span class="mark">o</span>onstage</a><span>© 2026 OnStage, Inc.</span><div class="footer-links"><a href="#">Support</a><a href="#">Terms</a><a href="#">Privacy</a></div></footer>
  </div>
  <div class="modal-backdrop" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal"><button class="modal-close" aria-label="Close">×</button><div class="checkout"><div class="eyebrow">Secure your access</div><h2 id="modalTitle">Start watching</h2><p>Your ticket unlocks the complete stream and a 30-day replay, so you never miss the moment.</p><div class="checkout-line"><span>Event access + replay</span><b>£12.00</b></div><button class="pay">Continue to secure checkout →</button></div><div class="success"><div class="check">✓</div><h2>You’re on the list.</h2><p>We’ll save your place and send your access link before the event begins.</p></div></div></div>
  <script>
    const modal = document.getElementById('modal');
    const title = document.getElementById('modalTitle');
    const checkout = modal.querySelector('.checkout');
    const success = modal.querySelector('.success');
    function openModal(name) { title.textContent = name; checkout.style.display = 'block'; success.style.display = 'none'; modal.classList.add('open'); document.body.style.overflow='hidden'; }
    function closeModal() { modal.classList.remove('open'); document.body.style.overflow=''; }
    document.querySelectorAll('[data-modal]').forEach(button => button.addEventListener('click', () => openModal(button.dataset.modal)));
    document.querySelector('.modal-close').addEventListener('click', closeModal);
    modal.addEventListener('click', event => { if(event.target === modal) closeModal(); });
    document.addEventListener('keydown', event => { if(event.key === 'Escape') closeModal(); });
    document.querySelector('.pay').addEventListener('click', () => { checkout.style.display='none'; success.style.display='block'; });
    document.querySelectorAll('[data-scroll]').forEach(button => button.addEventListener('click', () => document.querySelector(button.dataset.scroll).scrollIntoView({behavior:'smooth'})));
  </script>
</body>
</html>
